    {
      "name": "05 Analytics",
      "item": [
        {
          "name": "Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/analytics/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Dashboard contains expense and maintenance summaries', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('expenses');",
                  "  pm.expect(json).to.have.property('maintenance');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Expense Spend By Category",
          "request": {
